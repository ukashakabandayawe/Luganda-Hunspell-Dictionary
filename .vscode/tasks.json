{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "bundleUser",
			"type": "promptString",
			"description": "Username to export a bundle for (e.g. alfa)",
			"default": "alfa"
		},
		{
			"id": "batchBundleLimitExamples",
			"type": "promptString",
			"description": "Batch export: max examples per task (0 is fastest)",
			"default": "0"
		},
		{
			"id": "batchBundleExamplesFor",
			"type": "pickString",
			"description": "Batch export: generate examples for",
			"options": [
				"pending",
				"all"
			],
			"default": "pending"
		},
		{
			"id": "bundleLimitExamples",
			"type": "promptString",
			"description": "Max examples per task",
			"default": "120"
		},
		{
			"id": "bundleExamplesFor",
			"type": "pickString",
			"description": "Generate examples for",
			"options": [
				"pending",
				"all"
			],
			"default": "pending"
		}
	],
	"tasks": [
		{
			"label": "Copy Luganda.aff/Luganda.dic to LanguageTool hunspell",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"& { $ErrorActionPreference = 'Stop'; $src = '${workspaceFolder}'; $dest = 'E:\\languagetool\\languagetool-language-modules\\lg\\src\\main\\resources\\org\\languagetool\\resource\\lg\\hunspell'; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item -Force -Path (Join-Path $src 'Luganda.aff'), (Join-Path $src 'Luganda.dic') -Destination $dest }"
			],
			"problemMatcher": []
		},
		{
			"label": "django: runserver",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"runserver"
			],
			"options": {
				"cwd": "${workspaceFolder}\\lgflagsite"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Sync aff flags",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"sync_luganda_aff_flags",
				"--progress",
				"on"
			]
		},
		{
			"label": "Sync dic to site (import --upsert)",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"import_luganda_dic",
				"--upsert",
				"--progress",
				"on"
			]
		},
		{
			"label": "Export offline bundle (user)",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"export_review_bundle",
				"--user",
				"${input:bundleUser}",
				"--progress",
				"on",
				"--limit-examples",
				"${input:bundleLimitExamples}",
				"--examples-for",
				"${input:bundleExamplesFor}"
			]
		},
		{
			"label": "Export offline bundles batch (alfa..lima)",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"export_review_bundles_batch",
				"--progress",
				"on",
				"--limit-examples",
				"${input:batchBundleLimitExamples}",
				"--examples-for",
				"${input:batchBundleExamplesFor}"
			]
		}
	]
}