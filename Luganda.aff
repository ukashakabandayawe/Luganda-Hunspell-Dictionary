PFX Nd eky by eky

# Class V nouns 
# Was using flag s and now uses flag Ne
PFX Ne Y 10
PFX Ne e 0 e.^r
PFX Ne e ama e.^r # eggi
PFX Ne e ma e.^r
PFX Ne eri ama er # erinnyo
PFX Ne eri ma e
PFX Ne ejj ama ejj # ejjuuni
PFX Ne ejj ma ejj
PFX Ne ery am ery # eryenvu 
PFX Ne ery m ery
PFX Ne er l er # lyenvu 

# Class VI nouns 
# Was using flag t and now uses Nf
PFX Nf Y 11
PFX Nf a   0   aka
PFX Nf aka obu aka[^mn]
PFX Nf aka bu aka[^mn]
PFX Nf aka obwa akamb
PFX Nf aka bwa akamb
PFX Nf aka obwa akan[aeiou]
PFX Nf aka bwa akan[aeiou]
PFX Nf aka obu akam[^b]
PFX Nf aka bu akam[^b]
PFX Nf aka obu akan[^aeiou]
PFX Nf aka bu akan[^aeiou]

# Class VII nouns 
# Was using flag u and now uses Ng 
PFX Ng Y 11
PFX Ng o 0 ol[wu]
PFX Ng olul enn olul # olulimi-->ennimi
PFX Ng olul n olul
PFX Ng olu en olu.[^mn]
PFX Ng olu n olu.[^mn]
PFX Ng olu em olu[bp] # olubuto-->embuto
PFX Ng olu m olu[bp] # mpapula
PFX Ng olu enzi oluggi # Enziggi
PFX Ng olu nzi oluggi
PFX Ng olw enny olwendo
PFX Ng olw nny olwendo

# Class VIII nouns (large stuff)
# Was using flag v and now uses Nh
PFX Nh Y 6
PFX Nh omu ogu omu # omuntu --> oguntu
PFX Nh omu gu omu
PFX Nh omw ogw omw
PFX Nh omw gw omw
PFX Nh omu aga omu
PFX Nh omu ga omu

# Class IX nouns 
# Was using flag w and now uses Ni
PFX Ni Y 3
PFX Ni o 0 oku # okutu --> kutu
PFX Ni oku ama oku # okutu --> amatu
PFX Ni oku ma oku # okugulu --> magulu

# Class X nouns
# Was using flag x and now uses Nj
PFX Nj Y 1
PFX Nj o 0 ot[uw]

