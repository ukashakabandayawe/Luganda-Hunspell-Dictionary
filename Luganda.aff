# I think this works for laba, luka, labuka, lya, leka, laluka, (o)lidde
# TO-DO: Change the flag
PFX VERB1 Y 2
PFX VERB1 l nd .
PFX VERB1 l end .

# Turning a verb into a common noun e.g okulya --> Omuli, okusomesa --> omusomesa
# TO-DO: Change the flag
# TO-DO: Dont forget to add the root for creating a noun from a verb in the Luganda.dic
PFX VTN Y 2 
PFX VTN 0 omu .
PFX VTN 0 mu .

# Creating a gerund e.g lya --> okulya, liisa --> okweelisa, liibwa --> okuliibwa
# TO-DO: Change the flag

PFX VTG Y 3 
PFX VTG 0 ku .
PFX VTG 0 oku .
PFX VTG 0 kwee .