# Class I nouns 
# formally used flag n but now uses Na
PFX Na Y 7
PFX Na o 0 om
PFX Na omu aba omu
PFX Na omu ba omu
PFX Na omw aba omw
PFX Na omw ba omw
PFX Na 0 ba [^om] # taata--> bataata
PFX Na 0 bi ffenne

# Class II nouns 
# Used flag p but now uses Nb
PFX Nb Y 5
PFX Nb o 0 om.[wu]
PFX Nb omu emi omu
PFX Nb omu mi omu
PFX Nb omw emy omw
PFX Nb omw my omw

# Class III nouns 
# Was using flag q but now uses Nc
PFX Nc Y 2
PFX Nc e 0 e
PFX Nc em 0 em # e.g emmayiro

# Class IV nouns 
# Was using flag r but now uses Nd
PFX Nd Y 10
PFX Nd e 0 eki
PFX Nd e 0 eky
PFX Nd eki ebi eki
PFX Nd eki bi eki
PFX Nd eky eby eky
PFX Nd eky by eky
PFX Nd eky ak eky  # ekyaalo-->akaalo
PFX Nd eky k eky
PFX Nd eky obw eky  # ekyaalo-->obwaalo 
PFX Nd eky bw eky

# Class V nouns 
# Was using flag s and now uses flag Ne
PFX Ne Y 13
PFX Ne e 0 e.^r
PFX Ne e ama e.^r # eggi
PFX Ne e ma e.^r
PFX Ne eri ama er # erinnyo
PFX Ne eri ma e
PFX Ne ejj ama ejj # ejjuuni
PFX Ne ejj ma ejj
PFX Ne ery am ery # eryenvu 
PFX Ne ery m ery
PFX Ne er l er # lyenvu 
PFX Ne ery ama erya # eryato-->amaato
PFX Ne ery ma erya
PFX Ne ery lya er # eryato-->lyaato

# Class VI nouns 
# Was using flag t and now uses Nf
PFX Nf Y 11
PFX Nf a   0   aka
