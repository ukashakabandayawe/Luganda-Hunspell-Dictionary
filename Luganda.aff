PFX yy 0 z' [aeiou]
PFX yy 0 ez' [aeiou]
PFX yy 0 kw' [aeiou]
PFX yy 0 okw' [aeiou]
PFX yy 0 g' [aeiou]
PFX yy 0 ag' [aeiou]
PFX yy 0 tw' [aeiou]
PFX yy 0 otw' [aeiou]

# Prefixes of nouns based on size e.g akaana, obwaana, ebyaana
# This rule is explosive, so I missed some words, knowingly and unknowingly
# Was using flag z but now uses zz
PFX zz Y 128
PFX zz omu otu omu # omusajja-->otusajja
PFX zz omu obu omu # omusajja-->obusajja
PFX zz omu olu omu # omusajja-->olusajja
PFX zz omu aka omu # omusajja-->akasajja
PFX zz omu ogu omu # omusajja-->ogusajja
PFX zz omu aga omu # omusajja-->agasajja
PFX zz omu eki omu # omusajja-->ekisajja
PFX zz omu ebi omu # omusajja-->ebisajja
PFX zz omw olw omw # omwana-->olwana
PFX zz omw aka omw # omwana-->akaana
PFX zz omw otw omw # omwana-->otwana
PFX zz omw obw omw # omwana-->obwana
PFX zz omw ogw omw # omwana-->ogwana
PFX zz omw aga omw # omwana-->agaana
PFX zz omw eky omw # omwana-->ekyana
PFX zz omw eby omw # omwana-->ebyana
PFX zz en otu en # ente-->otute
PFX zz em otu em # embuzi-->otubuzi
PFX zz en obu en # ente-->obute
PFX zz em obu em # embuzi-->obubuzi
PFX zz en olu en
PFX zz em olu em
PFX zz en aka en
PFX zz em aka em
