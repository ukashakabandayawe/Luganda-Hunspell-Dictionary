# Class X nouns
# Was using flag x and now uses Nj
PFX Nj Y 1
PFX Nj o 0 ot[uw]

# The impersonal possessive prefix
# Was using flag y but now uses yy
PFX yy Y 34
PFX yy 0 w' [aeiou]
PFX yy 0 ow' [aeiou]
PFX yy 0 b' [aeiou]
PFX yy 0 ab' [aeiou]
PFX yy 0 gw' [aeiou]
PFX yy 0 ogw' [aeiou]
PFX yy 0 gy' [aeiou]
PFX yy 0 egy' [aeiou]
PFX yy 0 y' [aeiou]
PFX yy 0 ey' [aeiou]
PFX yy 0 z' [aeiou]
PFX yy 0 ez' [aeiou]
PFX yy 0 ky' [aeiou]
PFX yy 0 eky' [aeiou]
PFX yy 0 by' [aeiou]
PFX yy 0 eby' [aeiou]
PFX yy 0 ly' [aeiou]
PFX yy 0 ely' [aeiou]
